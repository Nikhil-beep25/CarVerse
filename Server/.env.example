# ============================================================
# CARVERSE BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment & Port
NODE_ENV=production
PORT=8000

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@carverse.ghnzlsr.mongodb.net/carverse?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=30d

# Frontend Client URL (For CORS Whitelist)
CLIENT_URL=https://your-carverse-frontend.vercel.app

# Initial Super Admin Provisioning
ADMIN_EMAIL=admin@carverse.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Payment Gateway (Razorpay - Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Service (SMTP - Optional)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
FROM_EMAIL=noreply@carverse.com
FROM_NAME=CarVerse

# Cloudinary Storage (For Persistent Cloud Image Uploads - Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
